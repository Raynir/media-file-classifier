<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="MediaFileClassifier.Ui.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://MediaFileClassifier.Ui/Theming/Tokens.axaml" />
        <ResourceInclude Source="avares://MediaFileClassifier.Ui/Theming/Icons.axaml" />
        <ResourceInclude Source="avares://MediaFileClassifier.Ui/Controls/MediaThumbnail.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://MediaFileClassifier.Ui/Theming/Styles.axaml" />
    <StyleInclude Source="avares://MediaFileClassifier.Ui/Commands/CommandStyles.axaml" />
  </Application.Styles>
</Application>
