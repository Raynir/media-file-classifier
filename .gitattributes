# Normalise line endings in the repository; check out with the platform default.
* text=auto

*.cs      text diff=csharp
*.axaml   text
*.xaml    text
*.csproj  text
*.props   text
*.targets text
*.slnx    text
*.ruleset text
*.json    text
*.md      text
*.ps1     text eol=crlf
*.cmd     text eol=crlf
*.bat     text eol=crlf
*.sh      text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.mp4  binary
*.ico  binary
*.onnx binary
