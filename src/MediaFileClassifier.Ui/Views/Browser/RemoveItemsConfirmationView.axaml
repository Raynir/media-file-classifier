<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Browser"
             x:Class="MediaFileClassifier.Ui.Views.Browser.RemoveItemsConfirmationView"
             x:DataType="vm:RemoveItemsConfirmationViewModel"
             MaxWidth="460">
  <!-- Remove from library (E02-S10-T03): the focus starts on Cancel, so Enter doesn't remove by accident. -->
  <StackPanel Margin="{DynamicResource Padding.Panel}" Spacing="{DynamicResource Space.L}">
    <TextBlock Classes="Title" Text="{Binding Question}" TextWrapping="Wrap" />
    <TextBlock Text="{l:Loc RemoveItems_Explanation}" TextWrapping="Wrap" />
    <CheckBox Content="{l:Loc RemoveItems_DontAskAgain}" IsChecked="{Binding DontAskAgain}" />
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space.S}">
      <Button x:Name="RemoveButton" Content="{l:Loc RemoveItems_Remove}" Command="{Binding RemoveCommand}" />
      <Button x:Name="CancelButton" Content="{l:Loc RemoveItems_Cancel}" Command="{Binding CancelCommand}" IsDefault="True" IsCancel="True" />
    </StackPanel>
  </StackPanel>
</UserControl>
