<!--
  Theme of the thumbnail cell (E03-S04-T05). The placeholder is a media type icon on a tile, with an error badge when
  the thumbnail couldn't be made. Provisional until the media browser design (E14).
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="using:MediaFileClassifier.Ui.Controls">
  <ControlTheme x:Key="{x:Type controls:MediaThumbnail}" TargetType="controls:MediaThumbnail">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Tile}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
    <Setter Property="CornerRadius" Value="{DynamicResource Radius.Tile}" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" ClipToBounds="True">
          <Panel>
            <Image Name="PART_Image" Source="{TemplateBinding Source}" Stretch="{TemplateBinding Stretch}" />
            <PathIcon Name="PART_PlaceholderIcon"
                      Classes="Large"
                      IsVisible="False"
                      Data="{StaticResource Icon.Media.Image}"
                      Foreground="{TemplateBinding Foreground}" />
            <Border Name="PART_FailedBadge"
                    IsVisible="False"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="{DynamicResource Padding.Compact}"
                    Padding="{DynamicResource Padding.Compact}"
                    CornerRadius="{DynamicResource Radius.Control}"
                    Background="{DynamicResource Brush.Status.Error.Background}">
              <PathIcon Classes="Small"
                        Data="{StaticResource Icon.Status.Error}"
                        Foreground="{DynamicResource Brush.Status.Error.Foreground}" />
            </Border>
          </Panel>
        </Border>
      </ControlTemplate>
    </Setter>

    <Style Selector="^:placeholder /template/ PathIcon#PART_PlaceholderIcon">
      <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="^:animated /template/ PathIcon#PART_PlaceholderIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Media.AnimatedImage}" />
    </Style>
    <Style Selector="^:video /template/ PathIcon#PART_PlaceholderIcon">
      <Setter Property="Data" Value="{StaticResource Icon.Media.Video}" />
    </Style>
    <Style Selector="^:failed /template/ Border#PART_FailedBadge">
      <Setter Property="IsVisible" Value="True" />
    </Style>
  </ControlTheme>
</ResourceDictionary>
