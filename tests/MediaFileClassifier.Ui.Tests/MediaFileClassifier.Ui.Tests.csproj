<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MediaFileClassifier.Ui/MediaFileClassifier.Ui.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Testing/MediaFileClassifier.Testing.csproj" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Avalonia.Headless" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- The XAML files, so the string and token checks can read them (E13-S08-T01, E13-S06-T02). -->
    <Content Include="../../src/MediaFileClassifier.Ui/**/*.axaml" Exclude="../../src/MediaFileClassifier.Ui/bin/**;../../src/MediaFileClassifier.Ui/obj/**" LinkBase="UiViews" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
