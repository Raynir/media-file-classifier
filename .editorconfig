root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{csproj,props,targets,slnx,ruleset,axaml,xaml,xml,manifest,json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Project-specific analyzer severities, on top of tools/MediaFileClassifier.ruleset (D065).
[*.cs]
csharp_style_namespace_declarations = file_scoped:warning
csharp_using_directive_placement = inside_namespace:warning

# Dead-code rules.
dotnet_diagnostic.IDE0005.severity = warning   # unnecessary using directive
dotnet_diagnostic.IDE0052.severity = warning   # private member is written but never read
dotnet_diagnostic.IDE0059.severity = warning   # value assigned is never used
dotnet_diagnostic.CA1823.severity = warning    # unused private field
