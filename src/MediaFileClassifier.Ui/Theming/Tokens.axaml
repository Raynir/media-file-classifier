<!--
  Design tokens (E13-S06-T02). PROVISIONAL values: read by hand off Figma file u5giHVrftWw32xq3mjxXdu
  (dark frames 25:89, 31:5628, 29:2872), because the designer's token list (E13-S11-T03) isn't delivered yet.
  The redesign replaces the values and keeps the names. Light values are derived, since Figma has dark frames only.
  Status and provenance colours aren't in Figma yet, so they are placeholders.
  Views use these through {DynamicResource Key} or the classes in Styles.axaml, never literal values.
  See docs/design-tokens.md.
-->
<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <!-- Surfaces -->
      <SolidColorBrush x:Key="Brush.Surface.Window" Color="#202020" />
      <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#202020" />
      <SolidColorBrush x:Key="Brush.Surface.Content" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Brush.Surface.Tile" Color="#333333" />
      <SolidColorBrush x:Key="Brush.Surface.Control" Color="#353535" />
      <SolidColorBrush x:Key="Brush.Surface.Input" Color="#303030" />
      <SolidColorBrush x:Key="Brush.Surface.Tooltip" Color="#1A1A1A" />
      <!-- Not in Figma: dims the window behind an overlay such as the shortcut reference. -->
      <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />
      <!-- Borders -->
      <SolidColorBrush x:Key="Brush.Border.Divider" Color="#404040" />
      <SolidColorBrush x:Key="Brush.Border.Control" Color="#606060" />
      <SolidColorBrush x:Key="Brush.Border.Selected" Color="#707070" />
      <!-- Text and icons -->
      <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#7A7A7A" />
      <SolidColorBrush x:Key="Brush.Text.Placeholder" Color="#66FFFFFF" />
      <SolidColorBrush x:Key="Brush.Icon" Color="#E3E3E3" />
      <!-- States -->
      <SolidColorBrush x:Key="Brush.State.Hover" Color="#0FFFFFFF" />
      <SolidColorBrush x:Key="Brush.State.Pressed" Color="#08FFFFFF" />
      <SolidColorBrush x:Key="Brush.State.Selected" Color="#1AFFFFFF" />
      <SolidColorBrush x:Key="Brush.State.Focus" Color="#FFFFFF" />
      <!-- Item status (placeholders) -->
      <SolidColorBrush x:Key="Brush.Status.Pending.Foreground" Color="#BDBDBD" />
      <SolidColorBrush x:Key="Brush.Status.Pending.Background" Color="#33BDBDBD" />
      <SolidColorBrush x:Key="Brush.Status.Error.Foreground" Color="#FF8A80" />
      <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#33FF8A80" />
      <SolidColorBrush x:Key="Brush.Status.Missing.Foreground" Color="#FFCC80" />
      <SolidColorBrush x:Key="Brush.Status.Missing.Background" Color="#33FFCC80" />
      <SolidColorBrush x:Key="Brush.Status.Offline.Foreground" Color="#90CAF9" />
      <SolidColorBrush x:Key="Brush.Status.Offline.Background" Color="#3390CAF9" />
      <SolidColorBrush x:Key="Brush.Status.Excluded.Foreground" Color="#9E9E9E" />
      <SolidColorBrush x:Key="Brush.Status.Excluded.Background" Color="#1A9E9E9E" />
      <!-- Provenance slots: the look is designed in E07-S11-T01 (M3). -->
      <SolidColorBrush x:Key="Brush.Provenance.Ai.Foreground" Color="#B39DDB" />
      <SolidColorBrush x:Key="Brush.Provenance.Ai.Background" Color="#26B39DDB" />
      <SolidColorBrush x:Key="Brush.Provenance.Edited.Foreground" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Provenance.Edited.Background" Color="#464646" />
      <SolidColorBrush x:Key="Brush.Provenance.Accepted.Foreground" Color="#CCFFFFFF" />
      <SolidColorBrush x:Key="Brush.Provenance.Accepted.Background" Color="#262626" />
      <SolidColorBrush x:Key="Brush.Provenance.NewSuggestion.Foreground" Color="#FFE082" />
      <SolidColorBrush x:Key="Brush.Provenance.NewSuggestion.Background" Color="#26FFE082" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Brush.Surface.Window" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Brush.Surface.Panel" Color="#F3F3F3" />
      <SolidColorBrush x:Key="Brush.Surface.Content" Color="#FAFAFA" />
      <SolidColorBrush x:Key="Brush.Surface.Tile" Color="#E6E6E6" />
      <SolidColorBrush x:Key="Brush.Surface.Control" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Surface.Input" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Surface.Tooltip" Color="#FFFFFF" />
      <SolidColorBrush x:Key="Brush.Scrim" Color="#66000000" />
      <SolidColorBrush x:Key="Brush.Border.Divider" Color="#E0E0E0" />
      <SolidColorBrush x:Key="Brush.Border.Control" Color="#C4C4C4" />
      <SolidColorBrush x:Key="Brush.Border.Selected" Color="#8A8A8A" />
      <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#CC000000" />
      <SolidColorBrush x:Key="Brush.Text.Tertiary" Color="#6E6E6E" />
      <SolidColorBrush x:Key="Brush.Text.Placeholder" Color="#73000000" />
      <SolidColorBrush x:Key="Brush.Icon" Color="#3A3A3A" />
      <SolidColorBrush x:Key="Brush.State.Hover" Color="#0A000000" />
      <SolidColorBrush x:Key="Brush.State.Pressed" Color="#05000000" />
      <SolidColorBrush x:Key="Brush.State.Selected" Color="#14000000" />
      <SolidColorBrush x:Key="Brush.State.Focus" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Brush.Status.Pending.Foreground" Color="#616161" />
      <SolidColorBrush x:Key="Brush.Status.Pending.Background" Color="#1F616161" />
      <SolidColorBrush x:Key="Brush.Status.Error.Foreground" Color="#C42B1C" />
      <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#1FC42B1C" />
      <SolidColorBrush x:Key="Brush.Status.Missing.Foreground" Color="#9D5D00" />
      <SolidColorBrush x:Key="Brush.Status.Missing.Background" Color="#1F9D5D00" />
      <SolidColorBrush x:Key="Brush.Status.Offline.Foreground" Color="#005FB8" />
      <SolidColorBrush x:Key="Brush.Status.Offline.Background" Color="#1F005FB8" />
      <SolidColorBrush x:Key="Brush.Status.Excluded.Foreground" Color="#6E6E6E" />
      <SolidColorBrush x:Key="Brush.Status.Excluded.Background" Color="#146E6E6E" />
      <SolidColorBrush x:Key="Brush.Provenance.Ai.Foreground" Color="#5E35B1" />
      <SolidColorBrush x:Key="Brush.Provenance.Ai.Background" Color="#1A5E35B1" />
      <SolidColorBrush x:Key="Brush.Provenance.Edited.Foreground" Color="#1A1A1A" />
      <SolidColorBrush x:Key="Brush.Provenance.Edited.Background" Color="#DADADA" />
      <SolidColorBrush x:Key="Brush.Provenance.Accepted.Foreground" Color="#CC000000" />
      <SolidColorBrush x:Key="Brush.Provenance.Accepted.Background" Color="#EDEDED" />
      <SolidColorBrush x:Key="Brush.Provenance.NewSuggestion.Foreground" Color="#8A6100" />
      <SolidColorBrush x:Key="Brush.Provenance.NewSuggestion.Background" Color="#1F8A6100" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- Spacing scale (Figma uses 4, 8, 12, 16, 20, 24). -->
  <x:Double x:Key="Space.XS">4</x:Double>
  <x:Double x:Key="Space.S">8</x:Double>
  <x:Double x:Key="Space.M">12</x:Double>
  <x:Double x:Key="Space.L">16</x:Double>
  <x:Double x:Key="Space.XL">20</x:Double>
  <x:Double x:Key="Space.XXL">24</x:Double>
  <Thickness x:Key="Padding.Panel">20,16</Thickness>
  <Thickness x:Key="Padding.Header">16</Thickness>
  <Thickness x:Key="Padding.Control">12,6</Thickness>
  <Thickness x:Key="Padding.Compact">4</Thickness>
  <!-- A collapsed panel's strip: Padding.Compact across, level with Padding.Header vertically. -->
  <Thickness x:Key="Padding.Strip">4,16</Thickness>
  <!-- A status bar segment: Space.S across, the bar's full height. -->
  <Thickness x:Key="Padding.StatusSegment">8,0</Thickness>
  <!-- Lists in dialogs and overlays: space under a group, and around a row. -->
  <Thickness x:Key="Padding.Group">0,0,0,16</Thickness>
  <Thickness x:Key="Padding.Row">0,2</Thickness>

  <!-- Corner radii -->
  <CornerRadius x:Key="Radius.None">0</CornerRadius>
  <CornerRadius x:Key="Radius.Control">4</CornerRadius>
  <CornerRadius x:Key="Radius.Tile">4</CornerRadius>
  <CornerRadius x:Key="Radius.Tooltip">12</CornerRadius>
  <CornerRadius x:Key="Radius.Pill">999</CornerRadius>
  <Thickness x:Key="Border.Thin">1</Thickness>

  <!-- Typography. Figma uses Roboto; the app bundles Inter (Avalonia.Fonts.Inter) until the font is decided. -->
  <FontFamily x:Key="Font.Family">fonts:Inter#Inter, $Default</FontFamily>
  <x:Double x:Key="FontSize.Title">18</x:Double>
  <x:Double x:Key="FontSize.Subtitle">14</x:Double>
  <x:Double x:Key="FontSize.Body">12</x:Double>
  <x:Double x:Key="FontSize.Caption">10</x:Double>
  <x:Double x:Key="FontSize.Badge">8</x:Double>
  <FontWeight x:Key="FontWeight.Title">Bold</FontWeight>
  <FontWeight x:Key="FontWeight.Label">SemiBold</FontWeight>
  <FontWeight x:Key="FontWeight.Body">Normal</FontWeight>

  <!-- Opacity states (Figma: inactive chips 0.4, inactive nav items 0.6). -->
  <x:Double x:Key="Opacity.Disabled">0.4</x:Double>
  <x:Double x:Key="Opacity.Inactive">0.6</x:Double>

  <!-- Layout sizes -->
  <x:Double x:Key="Size.Navigation.Expanded">240</x:Double>
  <x:Double x:Key="Size.Navigation.Collapsed">66</x:Double>
  <x:Double x:Key="Size.DetailsPanel">320</x:Double>
  <!-- Not in Figma, which only hides the details panel: a strip with the expand button (Size.Control plus Padding.Strip). -->
  <x:Double x:Key="Size.DetailsPanel.Collapsed">42</x:Double>
  <!-- Hit area of the panel splitters, over the 1px divider. -->
  <x:Double x:Key="Size.Splitter">6</x:Double>
  <!-- Not in Figma: the status bar (E13-S04), as high as a small control. -->
  <x:Double x:Key="Size.StatusBar">24</x:Double>
  <!-- Not in Figma: dialogs and overlay cards such as the shortcut reference. -->
  <x:Double x:Key="Size.Dialog.Width">520</x:Double>
  <x:Double x:Key="Size.Dialog.MaxHeight">560</x:Double>
  <x:Double x:Key="Size.Toolbar">72</x:Double>
  <x:Double x:Key="Size.ContentHeader">60</x:Double>
  <x:Double x:Key="Size.Control">34</x:Double>
  <x:Double x:Key="Size.Control.Small">24</x:Double>
  <x:Double x:Key="Size.Icon">24</x:Double>
  <x:Double x:Key="Size.Icon.Small">12</x:Double>
  <x:Double x:Key="Size.Icon.Large">48</x:Double>
  <x:Double x:Key="Size.Tile.Width">120</x:Double>
  <x:Double x:Key="Size.Tile.Height">97</x:Double>
  <x:Double x:Key="Size.ListRow">56</x:Double>
</ResourceDictionary>
