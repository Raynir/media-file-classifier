<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 11 only (D028, D039). Shared projects stay on plain net10.0 for Android. -->
    <TargetFramework>net10.0-windows10.0.22000.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.22000.0</SupportedOSPlatformVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DXGI adapter detection (Platform/WindowsHardwareDetector). -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Microsoft.AI.DirectML copies DirectML.dll only for an x64 PlatformTarget; this AnyCPU app runs as x64, so take
         its x64 build. Without it, ONNX Runtime loads the older DirectML.dll in System32 (E06-S08). -->
    <Microsoft_AI_DirectML_Bin_Dir_Target Condition="'$(PlatformTarget)' == '' Or '$(PlatformTarget)' == 'AnyCPU'">$(Microsoft_AI_DirectML_Bin_Dir_Windows_x64)</Microsoft_AI_DirectML_Bin_Dir_Target>
    <Microsoft_AI_DirectML_SkipDebugLayerCopy>true</Microsoft_AI_DirectML_SkipDebugLayerCopy>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../MediaFileClassifier.Ui/MediaFileClassifier.Ui.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure/MediaFileClassifier.Infrastructure.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.DataAccess/MediaFileClassifier.Infrastructure.DataAccess.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.Search/MediaFileClassifier.Infrastructure.Search.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.AI/MediaFileClassifier.Infrastructure.AI.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.Jobs/MediaFileClassifier.Infrastructure.Jobs.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.Media/MediaFileClassifier.Infrastructure.Media.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.Playback/MediaFileClassifier.Infrastructure.Playback.csproj" />
    <PackageReference Include="Avalonia.Desktop" />
    <!-- The native ONNX Runtime for Infrastructure.AI: the DirectML build, which also has the CPU provider (E06-S08). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Serilog.Extensions.Hosting" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <!-- The native LibVLC, trimmed to win-x64 and the playback plugins (D070). -->
  <Import Project="../MediaFileClassifier.Infrastructure.Playback/build/LibVlcWindows.props" />

</Project>
