<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.Search"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             x:Class="MediaFileClassifier.Ui.Views.Search.SearchBarView"
             x:DataType="vm:SearchBarViewModel"
             DragDrop.AllowDrop="True">
  <!-- The search box in the toolbar's Search slot (E09-S01-T05, Figma 25:379). It fills the slot's width.
       A picture picked with the image button, dropped on the box or pasted into it shows as a chip (E09-S04-T01);
       the chip's look is provisional until the E09-S04 mockups are signed off. -->
  <TextBox x:Name="SearchBox"
           Classes="clearButton"
           HorizontalAlignment="Stretch"
           VerticalAlignment="Center"
           Text="{Binding Text}"
           PlaceholderText="{l:Loc Search_Placeholder}"
           AutomationProperties.Name="{l:Loc Search_Placeholder}">
    <TextBox.InnerLeftContent>
      <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}" VerticalAlignment="Center">
        <PathIcon Classes="Small" Data="{StaticResource Icon.Search}" Margin="{DynamicResource Padding.Compact}" />
        <Border x:Name="ImageChip"
                IsVisible="{Binding HasReferenceImage}"
                Background="{DynamicResource Brush.State.Hover}"
                CornerRadius="{DynamicResource Radius.Control}"
                Padding="{DynamicResource Padding.Badge}"
                ToolTip.Tip="{Binding ReferenceImageName}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}" VerticalAlignment="Center">
            <Image Source="{Binding ReferenceImage, Converter={x:Static vm:ReferenceImageThumbnail.Converter}}"
                   Width="{DynamicResource Size.Icon}"
                   Height="{DynamicResource Size.Icon}"
                   Stretch="UniformToFill" />
            <TextBlock Text="{Binding ReferenceImageName}"
                       MaxWidth="160"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center" />
            <Button x:Name="RemoveImageButton"
                    Classes="Icon"
                    Width="{DynamicResource Size.Icon}"
                    Height="{DynamicResource Size.Icon}"
                    Command="{Binding RemoveImageCommand}"
                    ToolTip.Tip="{l:Loc Search_RemoveImage}"
                    AutomationProperties.Name="{l:Loc Search_RemoveImage}">
              <PathIcon Classes="Small" Data="{StaticResource Icon.Close}" />
            </Button>
          </StackPanel>
        </Border>
        <!-- Similarity mode (E09-S03-T02): "Similar to: IMG_1234" with the item's thumbnail; text typed replaces it. -->
        <Border x:Name="SimilarChip"
                IsVisible="{Binding IsSimilarMode}"
                Background="{DynamicResource Brush.State.Hover}"
                CornerRadius="{DynamicResource Radius.Control}"
                Padding="{DynamicResource Padding.Badge}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}" VerticalAlignment="Center">
            <Image Source="{Binding SimilarThumbnail}"
                   Width="{DynamicResource Size.Icon}"
                   Height="{DynamicResource Size.Icon}"
                   Stretch="UniformToFill" />
            <TextBlock VerticalAlignment="Center"
                       MaxWidth="180"
                       TextTrimming="CharacterEllipsis"
                       Text="{Binding SimilarLabel}" />
            <!-- "Analyze now" for an item without an embedding (E09-S03-T03, D036), and how it goes. -->
            <TextBlock x:Name="AnalyzeStatus"
                       Classes="Secondary Caption"
                       VerticalAlignment="Center"
                       IsVisible="{Binding HasAnalyzeStatus}"
                       Text="{Binding AnalyzeStatus}" />
            <Button x:Name="AnalyzeNowButton"
                    Classes="accent"
                    Padding="{DynamicResource Padding.Compact}"
                    IsVisible="{Binding IsAnalyzeNowOffered}"
                    Command="{Binding AnalyzeNowCommand}"
                    Content="{l:Loc Search_AnalyzeNow}" />
            <Button Classes="Icon Small"
                    Command="{Binding ClearSimilarCommand}"
                    ToolTip.Tip="{l:Loc Search_ClearSimilar}"
                    AutomationProperties.Name="{l:Loc Search_ClearSimilar}">
              <PathIcon Classes="Small" Data="{StaticResource Icon.Close}" />
            </Button>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ImageErrorText"
                   IsVisible="{Binding HasImageError}"
                   Text="{Binding ImageError}"
                   Foreground="{DynamicResource Brush.Status.Error.Foreground}"
                   MaxWidth="260"
                   TextTrimming="CharacterEllipsis"
                   ToolTip.Tip="{Binding ImageError}"
                   VerticalAlignment="Center" />
      </StackPanel>
    </TextBox.InnerLeftContent>
    <TextBox.InnerRightContent>
      <Button x:Name="PickImageButton"
              Classes="Icon"
              Command="{Binding PickImageCommand}"
              ToolTip.Tip="{l:Loc Search_PickImage}"
              AutomationProperties.Name="{l:Loc Search_PickImage}">
        <PathIcon Classes="Small" Data="{StaticResource Icon.Image}" />
      </Button>
    </TextBox.InnerRightContent>
    <TextBox.KeyBindings>
      <KeyBinding Gesture="Enter" Command="{Binding SubmitCommand}" />
      <KeyBinding Gesture="Escape" Command="{Binding ClearCommand}" />
    </TextBox.KeyBindings>
  </TextBox>
</UserControl>
