# Keyboard in dialogs (MFC-131): Tab stays in the dialog, Escape closes it, and the focus returns to the grid.
# The report of each dialog-key step names the control that had the focus.
#   dotnet run --project src/MediaFileClassifier.Desktop -- --smoke tools/ui-smoke/keyboard-dialogs.smoke --out artifacts/ui-smoke

window 1400x900
library sample
select jpeg-exif.jpg
focus Scroller
start item.remove
wait-for dialog
# The dialog opens with the focus on its safe default button, Cancel (MFC-1012).
dialog-focus CancelButton
dialog-shot 00-remove-initial-focus
dialog-key Tab
dialog-key Tab
dialog-key Tab
dialog-key Escape
wait-for no-dialog
key Tab
# F6 reaches the status bar when it has a clickable segment: browser -> details -> status bar.
command view.details-expanded
focus Scroller
key F6
key F6
key F6
shot 08-f6-status-bar

# Delete library opens on its typed-confirmation box (MFC-1012).
start library.delete
wait-for dialog
dialog-focus NameBox
dialog-shot 09-delete-library-initial-focus
dialog-key Escape
wait-for no-dialog
