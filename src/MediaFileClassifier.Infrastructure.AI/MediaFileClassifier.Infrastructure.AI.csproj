<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="../MediaFileClassifier.Infrastructure.Abstractions/MediaFileClassifier.Infrastructure.Abstractions.csproj" />
    <!-- The managed API only: each head brings the native runtime it needs (CPU, DirectML, CUDA or Android). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.AI.OpenAI" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.ML.Tokenizers" />
    <PackageReference Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Models/model-catalog.json" LogicalName="MediaFileClassifier.Infrastructure.AI.Models.model-catalog.json" />
    <EmbeddedResource Include="Prompts/*.json" LogicalName="MediaFileClassifier.Infrastructure.AI.Prompts.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MediaFileClassifier.Infrastructure.Tests" />
  </ItemGroup>

</Project>
