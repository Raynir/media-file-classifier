<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Details"
             xmlns:d="using:MediaFileClassifier.Ui.Details"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             xmlns:sc="using:MediaFileClassifier.Ui.Shortcuts"
             x:Class="MediaFileClassifier.Ui.Views.Details.MetadataEditorView"
             x:Name="Root"
             sc:Shortcuts.Scope="editor"
             x:DataType="vm:MetadataEditorViewModel">
  <!--
    The metadata editor (E07-S02): descriptive fields, AI analysis fields and tags in collapsible sections, with the
    Save and Cancel bar under them while something is unsaved. Provisional layout after the Figma Overview tab (D095):
    there is no E07-S02-T00 design for M3.
  -->
  <UserControl.Resources>
    <!-- One field: its label, an Edited mark while it has an unsaved change, the text box and its validation error. -->
    <DataTemplate x:Key="FieldTemplate" x:DataType="d:EditableFieldViewModel">
      <Border Classes="FieldDirty" Classes.Dirty="{Binding IsDirty}" Margin="{DynamicResource Padding.Field}">
        <Border.Styles>
          <Style Selector="Border.FieldDirty:not(.Dirty)">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,0,0,0" />
          </Style>
        </Border.Styles>
        <StackPanel Spacing="{DynamicResource Space.XS}">
          <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.S}">
            <TextBlock Classes="FieldLabel" Text="{Binding Label}" />
            <!-- What the stored value is: the AI's, the user's edit or an accepted AI value, with model and date in the tooltip. -->
            <Border Classes="Provenance Ai" IsVisible="{Binding IsAi}" ToolTip.Tip="{Binding ProvenanceTip}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                <PathIcon Data="{StaticResource Icon.Provenance.Ai}" />
                <TextBlock Text="{l:Loc Provenance_Ai}" />
              </StackPanel>
            </Border>
            <Border Classes="Provenance Edited" IsVisible="{Binding IsEditedValue}" ToolTip.Tip="{Binding ProvenanceTip}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                <PathIcon Data="{StaticResource Icon.Provenance.Edited}" />
                <TextBlock Text="{l:Loc Provenance_Edited}" />
              </StackPanel>
            </Border>
            <Border Classes="Provenance Accepted" IsVisible="{Binding IsAccepted}" ToolTip.Tip="{Binding ProvenanceTip}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                <PathIcon Data="{StaticResource Icon.Provenance.Accepted}" />
                <TextBlock Text="{l:Loc Provenance_Accepted}" />
              </StackPanel>
            </Border>
            <Border Classes="Provenance NewSuggestion" IsVisible="{Binding HasSuggestion}" ToolTip.Tip="{Binding SuggestionTip}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                <PathIcon Data="{StaticResource Icon.Provenance.NewSuggestion}" />
                <TextBlock Text="{l:Loc Provenance_NewSuggestion}" />
              </StackPanel>
            </Border>
            <TextBlock Classes="EditedMark" Text="{l:Loc Editor_Edited}" IsVisible="{Binding IsDirty}" />
            <Button Classes="Small"
                    Content="{l:Loc Editor_Revert}"
                    Command="{Binding RevertCommand}"
                    IsVisible="{Binding CanRevert}" />
          </StackPanel>
          <TextBox Text="{Binding Text}"
                   IsReadOnly="{Binding IsReadOnly}"
                   AcceptsReturn="{Binding !IsSingleLine}"
                   TextWrapping="Wrap"
                   MaxHeight="160"
                   AutomationProperties.Name="{Binding Label}" />
          <TextBlock Classes="FieldError"
                     Text="{Binding Error}"
                     IsVisible="{Binding Error, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.EditedMark">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Provenance.Edited.Foreground}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>
    <Style Selector="TextBlock.FieldError">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Status.Error.Foreground}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="Border.FieldDirty">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Provenance.Edited.Foreground}" />
      <Setter Property="BorderThickness" Value="2,0,0,0" />
      <Setter Property="Padding" Value="8,0,0,0" />
    </Style>
    <Style Selector="Border.Chip.Added">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Provenance.Edited.Foreground}" />
      <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Border.Chip:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.State.Focus}" />
    </Style>
    <Style Selector="TextBlock.ChipText.Struck">
      <Setter Property="TextDecorations" Value="Strikethrough" />
    </Style>
<Style Selector="TextBlock.ChipSource">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.ChipButton">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="4,0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="Focusable" Value="False" />
    </Style>
    <Style Selector="Border.Chip">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Save and Cancel, only while there are unsaved changes. -->
    <Border DockPanel.Dock="Bottom"
            x:Name="SaveBar"
            IsVisible="{Binding IsDirty}"
            BorderBrush="{DynamicResource Brush.Border.Divider}"
            BorderThickness="0,1,0,0"
            Padding="{DynamicResource Padding.Panel}">
      <DockPanel LastChildFill="False">
        <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
          <TextBlock Classes="Secondary" Text="{l:Loc Editor_Unsaved}" />
          <TextBlock Classes="Secondary"
                     x:Name="NoticeText"
                     TextWrapping="Wrap"
                     Text="{Binding Notice}"
                     IsVisible="{Binding Notice, Converter={x:Static ObjectConverters.IsNotNull}}" />
          <TextBlock Classes="FieldError"
                     Text="{Binding SaveError}"
                     IsVisible="{Binding SaveError, Converter={x:Static ObjectConverters.IsNotNull}}" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource Space.S}">
          <Button x:Name="CancelButton"
                  Content="{l:Loc Editor_Cancel}"
                  Command="{Binding CancelCommand}" />
          <Button x:Name="SaveButton"
                 
                  Content="{l:Loc Editor_Save}"
                  Command="{Binding SaveCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer>
      <StackPanel Margin="{DynamicResource Padding.Panel}" Spacing="{DynamicResource Space.M}">
        <Expander Header="{l:Loc Editor_Section_Descriptive}" IsExpanded="True" HorizontalAlignment="Stretch">
          <ItemsControl ItemsSource="{Binding Descriptive}" ItemTemplate="{StaticResource FieldTemplate}" />
        </Expander>
        <Expander Header="{l:Loc Editor_Section_Analysis}" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="{DynamicResource Space.S}">
            <ItemsControl ItemsSource="{Binding Analysis}" ItemTemplate="{StaticResource FieldTemplate}" />
            <ContentControl Content="{Binding Transcript}"
                            ContentTemplate="{StaticResource FieldTemplate}"
                            IsVisible="{Binding HasTranscript}" />
          </StackPanel>
        </Expander>
        <Expander Header="{l:Loc Details_Tags}" IsExpanded="True" HorizontalAlignment="Stretch">
          <StackPanel Spacing="{DynamicResource Space.XS}">
            <TextBlock Classes="Tertiary" Text="{l:Loc Details_Tags_None}" IsVisible="{Binding !HasTags}" />
            <!-- Chips: the source icon, the tag, and remove / reject / undo. Staged changes are an outline (added) or a strikethrough. -->
            <ItemsControl x:Name="TagList" ItemsSource="{Binding Tags}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="d:TagChipViewModel">
                  <Border Classes="Chip"
                          Classes.Added="{Binding IsAdded}"
                          Focusable="True"
                          Margin="{DynamicResource Padding.Compact}"
                          AutomationProperties.Name="{Binding Text}">
                    <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
                      <TextBlock Classes="ChipSource" Text="{Binding Source, Converter={x:Static d:TagSourceConverters.Glyph}}"
                                 ToolTip.Tip="{Binding Source, Converter={x:Static d:TagSourceConverters.Description}}" />
                      <TextBlock Classes="ChipText"
                                 Classes.Struck="{Binding !CanReject}"
                                 Text="{Binding Text}" />
                      <Button Classes="ChipButton" Content="↶" IsVisible="{Binding !CanReject}"
                              Tag="Undo" ToolTip.Tip="{l:Loc Editor_Tag_Undo}" AutomationProperties.Name="{l:Loc Editor_Tag_Undo}" />
                      <Button Classes="ChipButton" Content="×" IsVisible="{Binding CanRemove}"
                              Tag="Remove" ToolTip.Tip="{l:Loc Editor_Tag_Remove}" AutomationProperties.Name="{l:Loc Editor_Tag_Remove}" />
                      <Button Classes="ChipButton" Content="⊘" IsVisible="{Binding CanReject}"
                              Tag="Reject" ToolTip.Tip="{l:Loc Editor_Tag_Reject}" AutomationProperties.Name="{l:Loc Editor_Tag_Reject}" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <AutoCompleteBox x:Name="TagInput"
                             Text="{Binding NewTagText}"
                             ItemsSource="{Binding Suggestions}"
                             FilterMode="None"
                             MinimumPrefixLength="0"
                             PlaceholderText="{l:Loc Editor_Tag_Input}"
                             AutomationProperties.Name="{l:Loc Editor_Tag_Input}" />
            <TextBlock Classes="Tertiary" Text="{l:Loc Editor_Tag_InputHelp}" TextWrapping="Wrap" />
            <TextBlock Classes="FieldError"
                       Text="{Binding TagError}"
                       IsVisible="{Binding TagError, Converter={x:Static ObjectConverters.IsNotNull}}" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
