<?xml version="1.0" encoding="utf-8"?>
<!-- No network: the app analyses media on the device only. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools"
          android:installLocation="auto">
  <!-- The ONNX Runtime AAR asks for these for its telemetry (MFC-18). -->
  <uses-permission android:name="android.permission.INTERNET" tools:node="remove" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" tools:node="remove" />
  <application android:label="Media File Classifier" android:icon="@drawable/icon">
    <provider android:name="ai.onnxruntime.TelemetryInitializer" tools:node="remove" />
  </application>
</manifest>
