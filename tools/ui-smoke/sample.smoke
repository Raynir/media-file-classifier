# Sample UI smoke script (MFC-1006). Steps are described in docs/testing.md.
# Run from the repository root:
#   dotnet run --project src/MediaFileClassifier.Desktop -- --smoke tools/ui-smoke/sample.smoke --out artifacts/ui-smoke

window 1400x900
command view.theme-light

# Browsing: a library scanned from tests/SampleMedia, thumbnails in.
library sample
shot 01-browse

# The details panel for a still image.
select jpeg-exif.jpg
command view.details-expanded
wait-for visible Preview
shot 02-details-image

# An animated image plays in the preview.
select gif-animated.gif
wait-for visible AnimationPlayer
wait 600ms
shot 03-animated-gif

select webp-animated.webp
wait-for visible AnimationPlayer

# A video: its details, then playback. The player draws LibVLC frames over the poster, with a timeline and
# keyframe markers (keyframes exist only after AI analysis, which needs the model, so the markers don't show in
# this script); the play button plays and pauses, and Home on the timeline seeks to the start.
select video-short.mp4
wait-for hidden AnimationPlayer
wait-for visible VideoPlayerView
shot 04-video-poster
focus PlayButton
key Space
wait 1500ms
shot 05-video-playing
key Space
wait 300ms
focus Timeline
key Home
wait 600ms
shot 06-video-seek

# Collapse the details panel again.
command view.details-collapsed
wait-for hidden Preview
