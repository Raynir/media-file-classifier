<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Libraries"
             x:Class="MediaFileClassifier.Ui.Views.Libraries.ExcludedItemsView"
             x:DataType="vm:ExcludedItemsViewModel">
  <!-- Excluded items (E02-S10-T04): the items the user removed, with Restore and Forget. -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="{DynamicResource Padding.Panel}" RowSpacing="{DynamicResource Space.M}">
    <StackPanel Spacing="{DynamicResource Space.S}">
      <TextBlock Classes="Title" Text="{l:Loc ExcludedItems_Title}" IsVisible="{Binding !IsEmbedded}" />
      <TextBlock Classes="Secondary" Text="{Binding Header}" IsVisible="{Binding !IsEmpty}" TextWrapping="Wrap" />
      <Border Classes="Panel" Padding="{DynamicResource Padding.Control}" IsVisible="{Binding IsConfirmingForget}">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="{DynamicResource Space.S}" VerticalAlignment="Center">
            <Button x:Name="ConfirmForgetButton" Content="{l:Loc ExcludedItems_ForgetConfirm}" Command="{Binding ConfirmForgetCommand}" />
            <Button Content="{l:Loc ExcludedItems_ForgetCancel}" Command="{Binding CancelForgetCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding ForgetWarning}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="{DynamicResource Padding.Compact}" />
        </DockPanel>
      </Border>
      <TextBlock Foreground="{DynamicResource Brush.Status.Error.Foreground}" Text="{Binding Error}" IsVisible="{Binding HasError}" TextWrapping="Wrap" />
    </StackPanel>

    <Panel Grid.Row="1">
      <TextBlock Classes="Secondary" Text="{l:Loc ExcludedItems_Empty}" IsVisible="{Binding IsEmpty}" HorizontalAlignment="Center" VerticalAlignment="Center" />
      <ListBox x:Name="ItemList"
               ItemsSource="{Binding Items}"
               SelectionMode="Multiple"
               SelectionChanged="OnSelectionChanged"
               IsVisible="{Binding !IsEmpty}"
               AutomationProperties.Name="{l:Loc ExcludedItems_Title}">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:ExcludedItemRowViewModel">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Space.M}">
              <StackPanel>
                <TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" />
                <TextBlock Classes="Secondary" Text="{Binding FolderPath}" TextTrimming="{x:Static TextTrimming.PrefixCharacterEllipsis}" />
              </StackPanel>
              <TextBlock Grid.Column="1" Classes="Secondary" Text="{Binding RemovedOn}" VerticalAlignment="Center" />
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Panel>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="{DynamicResource Space.S}">
      <Button Content="{l:Loc ExcludedItems_Restore}" Command="{Binding RestoreCommand}" Classes="accent" />
      <Button Content="{l:Loc ExcludedItems_Forget}" Command="{Binding ForgetCommand}" />
      <Button Content="{l:Loc ExcludedItems_Close}" Command="{Binding CloseCommand}" IsCancel="{Binding !IsEmbedded}" IsVisible="{Binding !IsEmbedded}" />
    </StackPanel>
  </Grid>
</UserControl>
