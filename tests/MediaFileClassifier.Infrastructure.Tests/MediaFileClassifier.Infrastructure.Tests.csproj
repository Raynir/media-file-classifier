<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure/MediaFileClassifier.Infrastructure.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.AI/MediaFileClassifier.Infrastructure.AI.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.DataAccess/MediaFileClassifier.Infrastructure.DataAccess.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.Jobs/MediaFileClassifier.Infrastructure.Jobs.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.Media/MediaFileClassifier.Infrastructure.Media.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.Playback/MediaFileClassifier.Infrastructure.Playback.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.Infrastructure.Search/MediaFileClassifier.Infrastructure.Search.csproj" />
    <ProjectReference Include="../../src/MediaFileClassifier.UseCases/MediaFileClassifier.UseCases.csproj" />
    <ProjectReference Include="../MediaFileClassifier.Testing/MediaFileClassifier.Testing.csproj" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- The native CPU runtime for the ONNX provider tests; -p:OnnxGpu=true swaps in DirectML to time models on the GPU
         (FullProfileThroughputTests). -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" Condition="'$(OnnxGpu)' != 'true'" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Condition="'$(OnnxGpu)' == 'true'" />
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Testing.Extensions.HangDump" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- SigLIP 2 reference outputs, written by tools/embedding-reference/make_reference.py. -->
    <None Include="AI/Embeddings/siglip2-reference.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The native LibVLC, trimmed to win-x64 and the playback plugins (D070). -->
  <Import Project="../../src/MediaFileClassifier.Infrastructure.Playback/build/LibVlcWindows.props" />

</Project>
