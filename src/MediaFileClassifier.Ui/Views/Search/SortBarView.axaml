<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.Search"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             x:Class="MediaFileClassifier.Ui.Views.Search.SortBarView"
             x:DataType="vm:SortBarViewModel">
  <!--
    The sort control at the end of the results header (E10-S04-T02), as in the wireframe's "Relevance" dropdown, with a
    direction button that hides for relevance. Provisional until the T00 design is signed off.
  -->
  <StackPanel Orientation="Horizontal"
              Spacing="{DynamicResource Space.XS}"
              Margin="{DynamicResource Padding.Compact}"
              VerticalAlignment="Top">
    <ComboBox x:Name="SortMode"
              ItemsSource="{Binding Modes}"
              SelectedItem="{Binding SelectedMode}"
              MinWidth="120"
              VerticalAlignment="Center"
              AutomationProperties.Name="{l:Loc Sort_Label}"
              ToolTip.Tip="{l:Loc Sort_Label}">
      <ComboBox.ItemTemplate>
        <DataTemplate x:DataType="vm:SortOptionViewModel">
          <TextBlock Text="{Binding Text}" />
        </DataTemplate>
      </ComboBox.ItemTemplate>
    </ComboBox>
    <Button x:Name="SortDirection"
            Classes="FilterChip"
            IsVisible="{Binding IsDirectionVisible}"
            Command="{Binding ToggleDirectionCommand}"
            Content="{Binding DirectionGlyph}"
            VerticalAlignment="Center"
            AutomationProperties.Name="{Binding DirectionText}"
            ToolTip.Tip="{Binding DirectionText}" />
  </StackPanel>
</UserControl>
