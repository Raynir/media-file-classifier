<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Details"
             xmlns:d="using:MediaFileClassifier.Ui.Details"
             xmlns:v="using:MediaFileClassifier.Ui.Views.Details"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             xmlns:sc="using:MediaFileClassifier.Ui.Shortcuts"
             xmlns:al="using:Avalonia.Labs.AnimatedImage"
             x:Class="MediaFileClassifier.Ui.Views.Details.DetailsPanelView"
             x:DataType="vm:DetailsPanelViewModel">
  <!--
    Provisional details panel (D095), after the Figma "Viewer" component 29:2872: the preview, the file name, then
    Overview and Technical tabs. The preview is taller than Figma's 200 px when dragged, and collapses; quick actions
    sit in a row under the name, where later Stories add theirs. E14-S05-T00 designs the real one.
  -->
  <UserControl.Styles>
    <Style Selector="TextBlock.FieldLabel">
      <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Tertiary}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TabItem">
      <Setter Property="MinHeight" Value="{DynamicResource Size.Details.Tab}" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Subtitle}" />
      <Setter Property="Padding" Value="{DynamicResource Padding.Tab}" />
    </Style>
    <!-- Tag chips, as in Figma 29:2900. -->
    <Style Selector="Border.Chip">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Control}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Control}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Pill}" />
      <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    </Style>
    <Style Selector="Border.Chip TextBlock">
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
    </Style>
    <Style Selector="Border.PreviewOverlay">
      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Tooltip}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Radius.Control}" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Preview: collapsible, and resizable with the thumb under it. -->
    <DockPanel DockPanel.Dock="Top">
      <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.Compact}">
        <Button DockPanel.Dock="Right"
                Classes="Icon"
                Command="{Binding TogglePreviewCommand}"
                ToolTip.Tip="{l:Loc Details_Preview_Toggle}"
                AutomationProperties.Name="{l:Loc Details_Preview_Toggle}">
          <Panel>
            <PathIcon Data="{StaticResource Icon.ChevronUp}" IsVisible="{Binding IsPreviewExpanded}" />
            <PathIcon Data="{StaticResource Icon.ChevronDown}" IsVisible="{Binding !IsPreviewExpanded}" />
          </Panel>
        </Button>
        <TextBlock Classes="FieldLabel" Text="{l:Loc Details_Preview}" VerticalAlignment="Center" Margin="{DynamicResource Padding.Compact}" />
      </DockPanel>
      <StackPanel IsVisible="{Binding IsPreviewExpanded}">
        <Panel x:Name="PreviewArea"
               Height="{Binding PreviewHeight}"
               Background="{DynamicResource Brush.Surface.Tile}">
          <v:ZoomImage x:Name="Preview"
                       Source="{Binding PreviewBitmap}"
                       Orientation="{Binding PreviewOrientation}"
                       ImageSize="{Binding PreviewImageSize}"
                       RenderOptions.BitmapInterpolationMode="HighQuality"
                       sc:Shortcuts.Scope="viewer"
                       AutomationProperties.Name="{l:Loc Details_Preview}" />
          <!-- Animated GIF and WebP (E14-S12): the control plays; paused or stepped, the frame shows as a plain image. -->
          <Panel x:Name="AnimationHost"
                 IsVisible="{Binding Animation, Converter={x:Static ObjectConverters.IsNotNull}}"
                 Background="{DynamicResource Brush.Surface.Tile}">
            <Panel DataContext="{Binding Animation}" x:DataType="vm:AnimatedPreviewViewModel">
              <al:AnimatedImage x:Name="AnimationPlayer"
                                Source="{Binding PlaybackSource}"
                                IsPlaying="{Binding IsPlaying}"
                                IsVisible="{Binding IsPlaying}"
                                Stretch="Uniform"
                                StretchDirection="DownOnly" />
              <Image Source="{Binding CurrentFrame}"
                     IsVisible="{Binding IsPaused}"
                     Stretch="Uniform"
                     StretchDirection="DownOnly"
                     RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Panel>
          </Panel>
          <TextBlock Classes="Tertiary"
                     Text="{l:Loc Details_Preview_None}"
                     IsVisible="{Binding PreviewBitmap, Converter={x:Static ObjectConverters.IsNull}}"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center" />
          <!-- Zoom: the level, then Fit and 100%. -->
          <Border Classes="PreviewOverlay"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="{DynamicResource Padding.Compact}"
                  IsVisible="{Binding IsZoomAvailable}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}">
              <TextBlock x:Name="ZoomText" Classes="Small" VerticalAlignment="Center" Margin="{DynamicResource Padding.Compact}" />
              <Button x:Name="FitButton"
                      Classes="Small"
                      Content="{l:Loc Details_Preview_Fit}"
                      ToolTip.Tip="{l:Loc Details_Preview_Fit_ToolTip}" />
              <Button x:Name="ActualSizeButton"
                      Classes="Small"
                      Content="{l:Loc Details_Preview_ActualSize}"
                      ToolTip.Tip="{l:Loc Details_Preview_ActualSize_ToolTip}" />
            </StackPanel>
          </Border>
          <!-- Animation: step back, play or pause, step forward, and the frame. -->
          <Border Classes="PreviewOverlay"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="{DynamicResource Padding.Compact}"
                  IsVisible="{Binding Animation, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource Space.XS}" DataContext="{Binding Animation}" x:DataType="vm:AnimatedPreviewViewModel">
              <Button x:Name="StepBackButton"
                      Classes="Small"
                      Command="{Binding StepBackCommand}"
                      Content="{l:Loc Details_Preview_StepBack}"
                      ToolTip.Tip="{l:Loc Details_Preview_StepBack_ToolTip}" />
              <Button x:Name="PlayPauseButton"
                      Classes="Small"
                      Command="{Binding TogglePlayCommand}"
                      ToolTip.Tip="{l:Loc Details_Preview_PlayPause_ToolTip}">
                <Panel>
                  <TextBlock Text="{l:Loc Details_Preview_Pause}" IsVisible="{Binding IsPlaying}" />
                  <TextBlock Text="{l:Loc Details_Preview_Play}" IsVisible="{Binding IsPaused}" />
                </Panel>
              </Button>
              <Button x:Name="StepForwardButton"
                      Classes="Small"
                      Command="{Binding StepForwardCommand}"
                      Content="{l:Loc Details_Preview_StepForward}"
                      ToolTip.Tip="{l:Loc Details_Preview_StepForward_ToolTip}" />
              <TextBlock Classes="Small" Text="{Binding FrameText}" VerticalAlignment="Center" Margin="{DynamicResource Padding.Compact}" />
            </StackPanel>
          </Border>
          <!-- Too large to play: the first frame shows, and the file opens in the default app (D070, D026). -->
          <Border Classes="PreviewOverlay"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Bottom"
                  Margin="{DynamicResource Padding.Compact}"
                  IsVisible="{Binding IsAnimationTooLarge}">
            <Button Classes="Small"
                    Command="{Binding Commands[item.open-default-app]}"
                    Content="{l:Loc Details_Preview_Animation_OpenDefault}" />
          </Border>
        </Panel>
        <Thumb x:Name="PreviewResizer"
               Height="{DynamicResource Size.Splitter}"
               Cursor="SizeNorthSouth"
               Background="Transparent"
               AutomationProperties.Name="{l:Loc Details_Preview_Resize}" />
        <TextBlock Classes="Tertiary Caption"
                   Text="{Binding PreviewNote}"
                   IsVisible="{Binding PreviewNote, Converter={x:Static ObjectConverters.IsNotNull}}"
                   Margin="{DynamicResource Padding.Panel}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </DockPanel>

    <!-- Name, selection count and quick actions. -->
    <StackPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.Panel}" Spacing="{DynamicResource Space.XS}">
      <TextBlock Classes="Title" Text="{Binding Title}" TextWrapping="Wrap" />
      <TextBlock Classes="Secondary"
                 Text="{Binding Subtitle}"
                 IsVisible="{Binding Subtitle, Converter={x:Static ObjectConverters.IsNotNull}}"
                 TextWrapping="Wrap" />
      <TextBlock Classes="Secondary"
                 Text="{Binding SelectedCountText}"
                 IsVisible="{Binding !IsBulk}" />
      <!-- Quick actions (E14-S05): Open, Reveal and Find similar (E09-S03) now; Favorite and Re-analyze join with their Stories. -->
      <StackPanel x:Name="QuickActions"
                  Orientation="Horizontal"
                  Spacing="{DynamicResource Space.XS}"
                  AutomationProperties.Name="{l:Loc Details_Actions}">
        <Button Classes="Icon"
                Command="{Binding Commands[item.open-default-app]}"
                IsVisible="{Binding Commands[item.open-default-app].IsApplicable}"
                ToolTip.Tip="{Binding Commands[item.open-default-app].ToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding Commands[item.open-default-app].PlainLabel}">
          <PathIcon Data="{StaticResource Icon.OpenExternal}" />
        </Button>
        <Button Classes="Icon"
                Command="{Binding Commands[item.reveal]}"
                IsVisible="{Binding Commands[item.reveal].IsApplicable}"
                ToolTip.Tip="{Binding Commands[item.reveal].ToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding Commands[item.reveal].PlainLabel}">
          <PathIcon Data="{StaticResource Icon.FolderOpen}" />
        </Button>
        <Button Classes="Icon"
                Classes.Favorited="{Binding Commands[item.favorite].IsChecked}"
                Command="{Binding Commands[item.favorite]}"
                IsVisible="{Binding Commands[item.favorite].IsApplicable}"
                ToolTip.Tip="{Binding Commands[item.favorite].ToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding Commands[item.favorite].PlainLabel}">
          <PathIcon Data="{StaticResource Icon.Favorite}" />
        </Button>
        <Button Classes="Icon"
                Command="{Binding Commands[item.find-similar]}"
                IsVisible="{Binding Commands[item.find-similar].IsApplicable}"
                ToolTip.Tip="{Binding Commands[item.find-similar].ToolTip}"
                ToolTip.ShowOnDisabled="True"
                AutomationProperties.Name="{Binding Commands[item.find-similar].PlainLabel}">
          <PathIcon Data="{StaticResource Icon.Search}" />
        </Button>
      </StackPanel>
    </StackPanel>

    <!-- Overview and Technical. -->
    <TabControl SelectedIndex="{Binding SelectedTab}">
      <TabItem Header="{l:Loc Details_Tab_Overview}">
        <Panel>
          <Panel IsVisible="{Binding IsSingleEdit}">
            <v:MetadataEditorView x:Name="Editor" DataContext="{Binding Editor}" />
          </Panel>
          <Panel IsVisible="{Binding IsBulk}">
            <v:BulkEditorView x:Name="BulkEditor" DataContext="{Binding BulkEditor}" />
          </Panel>
        </Panel>
      </TabItem>
      <TabItem Header="{l:Loc Details_Tab_Technical}">
        <ScrollViewer>
          <ItemsControl ItemsSource="{Binding TechnicalRows}" Margin="{DynamicResource Padding.Panel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="d:DetailRow">
                <Grid ColumnDefinitions="Auto,*" MinHeight="{DynamicResource Size.Details.Row}">
                  <TextBlock Classes="FieldLabel"
                             Width="{DynamicResource Size.Details.LabelColumn}"
                             Text="{Binding Label}"
                             VerticalAlignment="Center"
                             TextWrapping="Wrap" />
                  <SelectableTextBlock Grid.Column="1"
                                       Text="{Binding Value}"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
