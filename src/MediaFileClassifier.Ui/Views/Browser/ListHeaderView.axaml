<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Browser"
             xmlns:views="using:MediaFileClassifier.Ui.Views.Browser"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             x:Class="MediaFileClassifier.Ui.Views.Browser.ListHeaderView"
             x:DataType="vm:ListColumnsViewModel">
  <!--
    The list view's column header (E14-S02). One cell per column, laid out by the same ListCellsPanel as the rows.
  -->
  <UserControl.Styles>
    <Style Selector="Border.ListHeaderCell">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Height" Value="{DynamicResource Size.Control.Small}" />
    </Style>
    <Style Selector="Border.ListHeaderCell TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="FontSize" Value="{DynamicResource FontSize.Caption}" />
      <Setter Property="FontWeight" Value="{DynamicResource FontWeight.Title}" />
    </Style>
    <Style Selector="Border.ListHeaderCell Path.HeaderIcon">
      <Setter Property="Width" Value="{DynamicResource Size.Icon.Small}" />
      <Setter Property="Height" Value="{DynamicResource Size.Icon.Small}" />
      <Setter Property="Stretch" Value="Uniform" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Text.Secondary}" />
    </Style>
    <Style Selector="Border.ListHeaderCell:pointerover">
      <Setter Property="Background" Value="{DynamicResource Brush.State.Hover}" />
    </Style>
    <Style Selector="Border.ListHeaderCell.Dragging">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="Thumb.ColumnResize">
      <Setter Property="Width" Value="6" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Cursor" Value="SizeWestEast" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}">
            <Border Width="1" HorizontalAlignment="Right" Background="{DynamicResource Brush.Border.Divider}" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="HeaderCellTemplate" x:DataType="vm:ListColumnViewModel">
      <Border Classes="ListHeaderCell" AutomationProperties.Name="{Binding Name}">
        <Panel>
          <DockPanel Margin="{DynamicResource Padding.Badge}">
            <TextBlock DockPanel.Dock="Right" Text="{Binding SortGlyph}" Classes="Secondary" />
            <TextBlock Text="{Binding Header}" Classes="Secondary" TextTrimming="CharacterEllipsis" />
            <!-- The favorite column has no title: its star says what it is, and the tooltip names it. -->
            <Path Classes="HeaderIcon"
                  Data="{StaticResource Icon.Favorite}"
                  IsVisible="{Binding HasHeaderIcon}"
                  ToolTip.Tip="{Binding Name}" />
          </DockPanel>
          <!-- Drag the right edge to resize (E14-S02-T02). -->
          <Thumb Classes="ColumnResize"
                 IsVisible="{Binding IsConfigurable}"
                 AutomationProperties.Name="{l:Loc List_Column_Resize}" />
        </Panel>
      </Border>
    </DataTemplate>
  </UserControl.Resources>

  <views:ListCellsPanel x:Name="Cells" Background="Transparent" AutomationProperties.Name="{l:Loc List_Header}">
    <views:ListCellsPanel.ContextMenu>
      <!-- Show and hide columns, and reset them (E14-S02-T02); filled when it opens. -->
      <ContextMenu x:Name="ColumnsMenu" />
    </views:ListCellsPanel.ContextMenu>
  </views:ListCellsPanel>
</UserControl>
