<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MediaFileClassifier.Ui.ViewModels.Libraries"
        xmlns:l="using:MediaFileClassifier.Ui.Localization"
        x:Class="MediaFileClassifier.Ui.Views.Libraries.CreateLibraryWindow"
        x:DataType="vm:CreateLibraryViewModel"
        Title="{l:Loc CreateLibrary_Title}"
        Width="560"
        Height="420"
        MinWidth="420"
        MinHeight="360"
        CanResize="True"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner">
  <!-- Hosts the shared create-library view on the desktop; the view locator maps the view model to CreateLibraryView. -->
  <ContentControl Content="{Binding}" />
</Window>
