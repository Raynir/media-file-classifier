<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MediaFileClassifier.Ui.ViewModels"
             xmlns:l="using:MediaFileClassifier.Ui.Localization"
             xmlns:sh="using:MediaFileClassifier.Ui.Shell"
             xmlns:v="using:MediaFileClassifier.Ui.Views"
             xmlns:vn="using:MediaFileClassifier.Ui.Views.Notifications"
             xmlns:vmo="using:MediaFileClassifier.Ui.Views.Models"
             x:Class="MediaFileClassifier.Ui.Views.MainView"
             x:DataType="vm:MainWindowViewModel"
             DragDrop.AllowDrop="True">
  <!--
    The shell (E13-S01): navigation on the left, the toolbar over the media browser and details, and the
    details panel on the right, after the Figma screens (D095). Features fill the areas through ShellRegions.
    The side panels resize with their splitters, collapse to a rail or strip, and hide.
  -->
  <UserControl.Styles>
    <!-- Docked, a panel is in its column. As a drawer (E13-S07) it lies over the whole shell grid, on one side. -->
    <Style Selector="Panel#NavigationHost" x:DataType="vm:MainWindowViewModel">
      <Setter Property="Width" Value="{Binding Layout.Navigation.Width}" />
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Grid.RowSpan" Value="2" />
    </Style>
    <Style Selector="Panel#NavigationHost.Collapsed">
      <Setter Property="Width" Value="{DynamicResource Size.Navigation.Collapsed}" />
    </Style>
    <Style Selector="Panel#NavigationHost.Drawer">
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="HorizontalAlignment" Value="Left" />
      <Setter Property="ZIndex" Value="2" />
    </Style>
    <Style Selector="Panel#DetailsHost" x:DataType="vm:MainWindowViewModel">
      <Setter Property="Width" Value="{Binding Layout.Details.Width}" />
      <Setter Property="Grid.Column" Value="2" />
      <Setter Property="Grid.ColumnSpan" Value="1" />
      <Setter Property="Grid.Row" Value="1" />
      <Setter Property="Grid.RowSpan" Value="1" />
    </Style>
    <Style Selector="Panel#DetailsHost.Collapsed">
      <Setter Property="Width" Value="{DynamicResource Size.DetailsPanel.Collapsed}" />
    </Style>
    <Style Selector="Panel#DetailsHost.Drawer">
      <Setter Property="Grid.Column" Value="0" />
      <Setter Property="Grid.ColumnSpan" Value="3" />
      <Setter Property="Grid.Row" Value="0" />
      <Setter Property="Grid.RowSpan" Value="2" />
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="ZIndex" Value="2" />
    </Style>
  </UserControl.Styles>

  <Panel>
  <DockPanel>
    <Menu x:Name="MainMenu" DockPanel.Dock="Top" Classes="Commands" ItemsSource="{Binding Menu.Groups}" />

    <!-- The "no model" banner (E06-S12-T04), while search has no embedding model. -->
    <vmo:ModelBannerView x:Name="ModelBanner" DockPanel.Dock="Top" DataContext="{Binding ModelBanner}" IsVisible="{Binding IsVisible}" />

    <Panel x:Name="StatusBarHost" DockPanel.Dock="Bottom" IsVisible="{Binding Layout.IsStatusBarVisible}">
      <Panel.ContextMenu>
        <ContextMenu Classes="Commands" ItemsSource="{Binding StatusBarContextMenu}" />
      </Panel.ContextMenu>
      <v:StatusBarView DataContext="{Binding StatusBar}" />
    </Panel>

    <Grid x:Name="ShellGrid" ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,*">
      <!-- Navigation -->
      <!-- While the navigation drawer is open over the rail, the rail's column stays as wide as the rail. -->
      <Border Grid.Row="0"
              Grid.RowSpan="2"
              Grid.Column="0"
              Classes="Panel"
              BorderThickness="0,0,1,0"
              Width="{DynamicResource Size.Navigation.Collapsed}"
              IsVisible="{Binding Layout.Navigation.KeepsRailColumn}" />
      <Panel x:Name="NavigationHost"
             IsVisible="{Binding Layout.Navigation.IsShown}"
             Classes.Collapsed="{Binding Layout.Navigation.IsRail}"
             Classes.Drawer="{Binding Layout.Navigation.IsDrawer}">
        <Border x:Name="NavigationPanel" Classes="Panel" BorderThickness="0,0,1,0">
          <Border.ContextMenu>
            <ContextMenu Classes="Commands" ItemsSource="{Binding NavigationContextMenu}" />
          </Border.ContextMenu>
          <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.Header}">
              <Button DockPanel.Dock="Left"
                      Classes="Icon"
                      Command="{Binding Commands[view.collapse-navigation]}"
                      ToolTip.Tip="{Binding Commands[view.collapse-navigation].ToolTip}"
                      AutomationProperties.Name="{Binding Commands[view.collapse-navigation].PlainLabel}">
                <PathIcon Data="{StaticResource Icon.Menu}" />
              </Button>
              <TextBlock Classes="Subtitle"
                         Text="{l:Loc Navigation_Title}"
                         IsVisible="{Binding Layout.Navigation.IsExpanded}"
                         Margin="{DynamicResource Padding.Compact}"
                         VerticalAlignment="Center"
                         TextWrapping="Wrap" />
            </DockPanel>
            <!-- The navigation view shows its own icon rail while the panel is collapsed (D108). -->
            <Panel>
              <ContentControl Content="{Binding Regions.Navigation}" />
              <Panel IsVisible="{Binding Layout.Navigation.IsExpanded}">
                <TextBlock Classes="Tertiary"
                           Text="{l:Loc Navigation_Empty}"
                           IsVisible="{Binding Regions.Navigation, Converter={x:Static ObjectConverters.IsNull}}"
                           Margin="{DynamicResource Padding.Panel}"
                           TextWrapping="Wrap" />
              </Panel>
            </Panel>
          </DockPanel>
        </Border>
        <sh:PanelSplitter x:Name="NavigationSplitter"
                          IsVisible="{Binding Layout.Navigation.IsResizable}"
                          HorizontalAlignment="Right"
                          PanelSide="Left"
                          Target="{Binding Layout.Navigation}"
                          Browser="{Binding #BrowserArea}"
                          AutomationProperties.Name="{l:Loc Splitter_Navigation}" />
      </Panel>

      <!-- Search and toolbar (E13-S03). Takes no space until a feature fills it. -->
      <Border x:Name="ToolbarArea"
              Grid.Row="0"
              Grid.Column="1"
              Grid.ColumnSpan="2"
              Classes="Panel"
              Height="{DynamicResource Size.Toolbar}"
              BorderThickness="0,0,0,1"
              IsVisible="{Binding Regions.Toolbar, Converter={x:Static ObjectConverters.IsNotNull}}">
        <ContentControl Content="{Binding Regions.Toolbar}" />
      </Border>

      <!-- Media browser -->
      <Border x:Name="BrowserArea" Grid.Row="1" Grid.Column="1" Classes="Content">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top" Height="{DynamicResource Size.ContentHeader}" Margin="{DynamicResource Padding.Header}">
            <Button DockPanel.Dock="Left"
                    Classes="Icon"
                    IsVisible="{Binding Layout.Navigation.NeedsOpenButton}"
                    Command="{Binding Commands[view.toggle-navigation]}"
                    ToolTip.Tip="{Binding Commands[view.toggle-navigation].ToolTip}"
                    AutomationProperties.Name="{Binding Commands[view.toggle-navigation].PlainLabel}">
              <PathIcon Data="{StaticResource Icon.PanelLeftOpen}" />
            </Button>
            <Button DockPanel.Dock="Right"
                    Classes="Icon"
                    IsVisible="{Binding Layout.Details.NeedsOpenButton}"
                    Command="{Binding Commands[view.toggle-details]}"
                    ToolTip.Tip="{Binding Commands[view.toggle-details].ToolTip}"
                    AutomationProperties.Name="{Binding Commands[view.toggle-details].PlainLabel}">
              <PathIcon Data="{StaticResource Icon.PanelRightOpen}" />
            </Button>
            <Panel />
          </DockPanel>
          <Panel>
            <ContentControl Content="{Binding Regions.Browser}" />
            <StackPanel IsVisible="{Binding Regions.Browser, Converter={x:Static ObjectConverters.IsNull}}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        MaxWidth="480"
                        Margin="{DynamicResource Padding.Panel}"
                        Spacing="{DynamicResource Space.S}">
              <PathIcon Classes="Large"
                        Data="{StaticResource Icon.Library}"
                        Foreground="{DynamicResource Brush.Text.Tertiary}" />
              <TextBlock Classes="Title"
                         Text="{l:Loc MainWindow_EmptyTitle}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
              <TextBlock Classes="Secondary"
                         Text="{l:Loc MainWindow_EmptyHint}"
                         TextAlignment="Center"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Panel>
        </DockPanel>
      </Border>

      <!-- Preview and details -->
      <Panel x:Name="DetailsHost"
             IsVisible="{Binding Layout.Details.IsShown}"
             Classes.Collapsed="{Binding Layout.Details.IsRail}"
             Classes.Drawer="{Binding Layout.Details.IsDrawer}">
        <Border x:Name="DetailsPanel" Classes="Panel" BorderThickness="1,0,0,0">
          <Border.ContextMenu>
            <ContextMenu Classes="Commands" ItemsSource="{Binding DetailsContextMenu}" />
          </Border.ContextMenu>
          <Panel>
            <DockPanel IsVisible="{Binding Layout.Details.IsExpanded}">
              <DockPanel DockPanel.Dock="Top" Margin="{DynamicResource Padding.Header}">
                <Button DockPanel.Dock="Right"
                        Classes="Icon"
                        Command="{Binding Commands[view.collapse-details]}"
                        ToolTip.Tip="{Binding Commands[view.collapse-details].ToolTip}"
                        AutomationProperties.Name="{Binding Commands[view.collapse-details].PlainLabel}">
                  <PathIcon Data="{StaticResource Icon.PanelRightClose}" />
                </Button>
                <TextBlock Classes="Title"
                           Text="{l:Loc Details_Title}"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap" />
              </DockPanel>
              <Panel>
                <ContentControl Content="{Binding Regions.Details}" />
                <TextBlock Classes="Tertiary"
                           Text="{l:Loc Details_Empty}"
                           IsVisible="{Binding Regions.Details, Converter={x:Static ObjectConverters.IsNull}}"
                           Margin="{DynamicResource Padding.Panel}"
                           TextWrapping="Wrap" />
              </Panel>
            </DockPanel>
            <!-- Collapsed: a strip with the expand button. -->
            <Button x:Name="DetailsExpandButton"
                    Classes="Icon"
                    IsVisible="{Binding Layout.Details.IsRail}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="{DynamicResource Padding.Strip}"
                    Command="{Binding Commands[view.collapse-details]}"
                    ToolTip.Tip="{Binding Commands[view.collapse-details].ToolTip}"
                    AutomationProperties.Name="{Binding Commands[view.collapse-details].PlainLabel}">
              <PathIcon Data="{StaticResource Icon.PanelRightOpen}" />
            </Button>
          </Panel>
        </Border>
        <sh:PanelSplitter x:Name="DetailsSplitter"
                          IsVisible="{Binding Layout.Details.IsResizable}"
                          HorizontalAlignment="Left"
                          PanelSide="Right"
                          Target="{Binding Layout.Details}"
                          Browser="{Binding #BrowserArea}"
                          AutomationProperties.Name="{l:Loc Splitter_Details}" />
      </Panel>

      <!-- Behind an open drawer (E13-S07): dims the browser, and a click on it closes the drawer. -->
      <Border x:Name="DrawerScrim"
              Grid.RowSpan="2"
              Grid.ColumnSpan="3"
              ZIndex="1"
              Background="{DynamicResource Brush.Scrim}"
              IsVisible="{Binding Layout.IsAnyDrawerOpen}"
              PointerPressed="OnScrimPressed" />
    </Grid>
  </DockPanel>

  <!-- Toasts (E15-S01), in the bottom-right corner above the status bar. -->
  <vn:ToastHostView x:Name="ToastHost" DataContext="{Binding Toasts}" />

  <!-- Drop overlay (E03-S06): dims the window while files or folders are dragged over it. -->
  <Panel x:Name="DropOverlay"
         IsHitTestVisible="False"
         Background="{DynamicResource Brush.Scrim}"
         IsVisible="{Binding Drops.IsDragActive, FallbackValue=False}">
    <Panel HorizontalAlignment="Center"
           VerticalAlignment="Center"
           AutomationProperties.Name="{l:Loc DropImport_Title}">
      <Border Classes="Panel" CornerRadius="{DynamicResource Radius.Control}" />
      <Rectangle Margin="{DynamicResource Margin.DropFrame}"
                 RadiusX="8"
                 RadiusY="8"
                 Stroke="{DynamicResource Brush.Border.Selected}"
                 StrokeThickness="2"
                 StrokeDashArray="4,3" />
      <StackPanel Margin="{DynamicResource Padding.DropCard}" Spacing="{DynamicResource Space.S}" HorizontalAlignment="Center">
        <PathIcon Classes="Large" Data="{StaticResource Icon.FolderAdd}" HorizontalAlignment="Center" />
        <TextBlock Classes="Title" Text="{l:Loc DropImport_Title}" TextAlignment="Center" />
        <TextBlock Classes="Secondary" Text="{l:Loc DropImport_Hint}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="360" />
      </StackPanel>
    </Panel>
  </Panel>

  <!-- Shortcut reference (E16-S01-T03), over everything. -->
  <v:ShortcutReferenceView x:Name="ShortcutReference"
                           DataContext="{Binding Shortcuts}"
                           IsVisible="{Binding State.IsOpen}" />
  </Panel>
</UserControl>
